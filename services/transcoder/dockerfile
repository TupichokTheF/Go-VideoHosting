FROM golang:1.26-alpine AS builder

ENV CGO_ENABLED 0

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -ldflags="-s -w" -o /out/transcoder ./cmd/worker


FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=builder /out/transcoder /app/transcoder

ENTRYPOINT ["/app/transcoder"]